  "version": "0.2.0",
  "type": "module",
  "description": "Xiaoman's persona resources and native Asuna preset",
  "icon": "icon.png",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
