{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asuna V1 TaskResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "intent_revision",
    "status",
    "facts",
    "uncertainties",
    "unmet_items",
    "artifact_refs",
    "effect_receipts",
    "needs_decision"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "intent_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "done",
        "partial",
        "blocked",
        "needs_character_decision"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unmet_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_decision": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
