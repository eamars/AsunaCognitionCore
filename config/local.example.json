{
  "database": "asuna_cognition_core_v2",
  "allowed_databases": [
    "asuna_cognition_core_v2"
  ],
  "mongo_uri": "mongodb://127.0.0.1:27017/?directConnection=true",
  "dsh_home": ".runtime/asuna-dsh",
  "embedding": {
    "base_url": "http://127.0.0.1:1234/v1",
    "model": "<embedding-model>",
    "query_prefix": "search_query: ",
    "document_prefix": "search_document: ",
    "api_key": ""
  },
  "vision": {
    "image_hosts": [
      "multimedia.nt.qq.com.cn",
      "gxh.vip.qq.com"
    ],
    "max_bytes": 4194304,
    "timeout_seconds": 15,
    "image_dirs": []
  },
  "workflow_timeout_seconds": 1800,
  "provider_idle_timeout_seconds": 1800,
  "self_development": {
    "enabled": true,
    "every_seconds": 86400
  },
  "chat": {
    "scene_id": "local-dm",
    "person_id": "local-user",
    "persona": "<persona-id>",
    "workspace": ".runtime/work/local-user",
    "read_only_paths": []
  }
}
