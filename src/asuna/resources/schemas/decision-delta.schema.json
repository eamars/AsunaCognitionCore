{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asuna:decision-delta:adr009",
  "title": "ADR-009 additions to the DECIDE schema",
  "description": "These optional properties are merged into the existing WORKSPACE decision schema. Each item is validated and committed independently; a rejected item is recorded in episode.rejections and never fails the turn. Only whole-JSON parse failure or a missing required base field keeps the existing BAD_DECISION_JSON behaviour. Timestamps are never supplied by the model. Outbound image attachments (attach) reference a program-listed image artifact for this turn; bytes stay in the blob store and only metadata is written on the message row.",
  "type": "object",
  "definitions": {
    "affect_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intensity",
        "ref",
        "why"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 32
        },
        "direction": {
          "enum": [
            "好",
            "坏"
          ]
        },
        "intensity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "arousal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "who": {
          "type": "string",
          "maxLength": 64
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "cost": {
          "type": "string",
          "maxLength": 200
        },
        "open": {
          "type": "boolean"
        }
      }
    },
    "doc_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]{0,127}$"
    }
  },
  "properties": {
    "affect": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/affect_event"
      }
    },
    "affect_ops": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "event_id"
        ],
        "properties": {
          "op": {
            "enum": [
              "close",
              "void"
            ]
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "maxLength": 500
          }
        },
        "if": {
          "properties": {
            "op": {
              "const": "void"
            }
          }
        },
        "then": {
          "required": [
            "why"
          ],
          "properties": {
            "why": {
              "minLength": 1
            }
          }
        }
      }
    },
    "affect_adopt": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "decision",
          "why"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "accept",
              "decline",
              "edit"
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "edit": {
            "$ref": "#/definitions/affect_event"
          }
        },
        "if": {
          "properties": {
            "decision": {
              "const": "edit"
            }
          }
        },
        "then": {
          "required": [
            "edit"
          ]
        }
      }
    },
    "write_docs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc",
          "op",
          "reason"
        ],
        "properties": {
          "doc": {
            "$ref": "#/definitions/doc_ref"
          },
          "op": {
            "enum": [
              "replace_section",
              "append_section",
              "correction",
              "set_tags",
              "adopt_seed"
            ]
          },
          "sid": {
            "type": "string",
            "maxLength": 128
          },
          "heading": {
            "type": "string",
            "maxLength": 200
          },
          "entry_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 32
            }
          },
          "visibility": {
            "enum": [
              "public",
              "owner_private"
            ]
          },
          "inject": {
            "enum": [
              "always",
              "on_demand",
              "never"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "read": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc",
          "sid"
        ],
        "properties": {
          "doc": {
            "$ref": "#/definitions/doc_ref"
          },
          "sid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "policy_set": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "reason"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "pin": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory_id",
          "pinned"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "minLength": 1
          },
          "pinned": {
            "type": "boolean"
          }
        }
      }
    },
    "promote": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "appraisal",
          "signal",
          "source_ids"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "appraisal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "signal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "enum": [
              "public",
              "owner_private"
            ]
          }
        }
      }
    },
    "group_action": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "who",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "mute",
              "unmute",
              "recall",
              "kick"
            ]
          },
          "who": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "duration": {
            "enum": [
              "1分钟",
              "10分钟",
              "1小时",
              "1天"
            ]
          },
          "which": {
            "enum": [
              "这条",
              "他刚才那条"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "attach": {
      "description": "随这一条要说的话一起发出去的图片（至多 1 条）。artifact_id 只能照抄上下文 image_artifacts_from_program.items 里给出的值——它不是文件路径也不是文件名。第一版只允许 session_class=owner_private 且该场景路由 target.type=dm 的回合，群方向确定性拒绝；不接受的条目只进 rejections，不影响这一轮。",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "why": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  },
  "examples": [
    {
      "next": "speak",
      "goal": "回应一次问候",
      "constraints": [],
      "recall_query": "",
      "speak_before_action": false,
      "affect": [
        {
          "kind": "joy",
          "val": 6,
          "arl": 4,
          "ref": "in-ep-demo-1",
          "why": "对方记得我上周提过的小事",
          "cost": "等了 1 天"
        }
      ]
    },
    {
      "next": "recall",
      "goal": "确认档案里的写法规矩",
      "constraints": [],
      "recall_query": "写法规矩",
      "speak_before_action": false,
      "read": [
        {
          "doc": "dossier:demo-user-1",
          "sid": "rules"
        }
      ]
    },
    {
      "next": "silent",
      "goal": "夜里不打扰",
      "constraints": [],
      "recall_query": "",
      "speak_before_action": false,
      "affect_ops": [
        {
          "op": "close",
          "event_id": "ev-demo-7",
          "why": "那件事今天办完了"
        }
      ],
      "write_docs": [
        {
          "doc": "dossier:demo-user-1",
          "op": "append_section",
          "heading": "今天的一件小事",
          "entry_date": "2026-01-02",
          "tags": [
            "entry",
            "injectable"
          ],
          "reason": "值得记下的具体时刻"
        }
      ]
    },
    {
      "next": "speak",
      "goal": "把刚画好的那张图给主人看",
      "constraints": [],
      "recall_query": "",
      "speak_before_action": false,
      "attach": [
        {
          "artifact_id": "blob-0f3c1e9a7b2d4c8f9a0b1c2d3e4f5061",
          "why": "他要看的就是这张图"
        }
      ]
    }
  ]
}
