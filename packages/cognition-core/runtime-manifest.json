  "developmentTools": [
    {
      "name": "development_files",
      "description": "Inspect the persistent candidate connected to this Asuna project.",
      "parameters": {
        "project": {
          "type": "string",
          "description": "Authorized project ID; defaults to the selected persona project. Use core for cognition runtime changes."
        },
        "prefix": {
          "type": "string",
          "description": "Optional relative path prefix"
        },
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer",
          "description": "Page size, maximum 100"
        }
      }
    },
    {
      "name": "development_read",
      "description": "Read a UTF-8 project file from the candidate.",
      "parameters": {
        "path": {
          "type": "string",
          "required": true
        },
        "project": {
          "type": "string",
          "description": "Authorized project ID; defaults to the selected persona project. Use core for cognition runtime changes."
        }
      }
    },
    {
      "name": "development_write",
      "description": "Write a UTF-8 project file in the candidate; changes are not active until publish.",
      "parameters": {
        "path": {
          "type": "string",
          "required": true
        },
        "text": {
          "type": "string",
          "required": true
        },
        "overwrite": {
          "type": "boolean"
        },
        "project": {
          "type": "string",
          "description": "Authorized project ID; defaults to the selected persona project. Use core for cognition runtime changes."
        }
      }
    },
    {
      "name": "development_run",
      "description": "Run a command in the candidate and return raw stdout, stderr and exit status, including failures.",
      "parameters": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": true
        },
        "project": {
          "type": "string",
          "description": "Authorized project ID; defaults to the selected persona project. Use core for cognition runtime changes."
        }
      }
    },
    {
      "name": "development_database_read",
      "description": "Read unredacted records from the existing real Asuna database, bound to this local owner development task. No public database endpoint.",
      "parameters": {
        "collection": {
          "type": "string",
          "required": true
        },
        "filter": {
          "type": "object",
          "additionalProperties": true
        },
        "projection": {
          "type": "object",
          "additionalProperties": true
        },
        "skip": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "project": {
          "type": "string",
          "description": "Authorized project ID; defaults to the selected persona project. Use core for cognition runtime changes."
        }
      }
    },
    {
      "name": "development_publish",
      "description": "Freeze this candidate, perform minimum non-consuming boot probe, and activate a bootable snapshot. Returns the actual probe result.",
      "parameters": {
        "reason": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "description": "Authorized project ID; defaults to the selected persona project. Use core for cognition runtime changes."
        }
      }
    }
  ]
}